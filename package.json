{
  "name": "vibeppt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "export": "node scripts/export-slides.mjs",
    "sync-tasks": "node scripts/sync-tasks-to-github.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --reporter verbose scripts/export.integration.test.mjs",
    "editor": "concurrently --names deck,editor --prefix-colors green,cyan \"vite\" \"npm --prefix editor run dev\"",
    "electron:dev": "NODE_ENV=development tsc -p tsconfig.electron.json && concurrently --kill-others --names vite,editor,electron --prefix-colors cyan,yellow,green \"vite --port 5173 --strictPort\" \"npm --prefix editor run dev\" \"wait-on http://localhost:5173 http://localhost:3000 && electron .\"",
    "electron:build": "vite build && npm --prefix editor run build && tsc -p tsconfig.electron.json",
    "electron:package": "npm run electron:build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.128",
    "@dagrejs/dagre": "^2.0.4",
    "@xyflow/react": "^12.10.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.3",
    "autoprefixer": "^10.4.21",
    "canvas": "^3.2.3",
    "concurrently": "^9.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.52.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.5"
  }
}
